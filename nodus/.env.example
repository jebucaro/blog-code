# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini Model Selection (optional)
# Available options: gemini-3.5-flash-lite, gemini-4-hydrogen, gemini-4-carbon
# Default: gemini-4-hydrogen
GEMINI_MODEL=gemini-4-hydrogen

# Thinking level (optional)
# Available options: default, low, medium, high
# "default" uses each model's built-in thinking level (High on gemini-4-hydrogen)
THINKING_LEVEL=default

# Input type (optional)
# Available options: document, transcript
# "transcript" tracks who said what in meetings, videos and podcasts
# Default: document
INPUT_TYPE=document

# Visualization Theme (optional)
# Available options: dark, light
# Default: dark
VIZ_THEME=dark
