# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini Model Selection (optional)
# Available options: gemini-3.1-flash-lite, gemini-3.5-flash, gemini-3.1-pro-preview
# Default: gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash

# Thinking level (optional)
# Available options: default, low, medium, high
# "default" uses each model's built-in thinking level
THINKING_LEVEL=default

# Visualization Theme (optional)
# Available options: dark, light
# Default: dark
VIZ_THEME=dark
